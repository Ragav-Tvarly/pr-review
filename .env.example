# Auth.js — `openssl rand -base64 32`
AUTH_SECRET=
# GitHub OAuth App (one per environment; callback = <origin>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Repos shown on the dashboard, comma-separated. Sign-in requires read access to the FIRST one.
GITHUB_REPOS=tvardev/tvar-business
# Claude Code scheduled task "tvar PR review" (created under admin@tvarlaunchpad.com) — API trigger
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=
# Review → fix loop (P5)
REVIEW_SCORE_BAR=80
REVIEW_FIX_ROUNDS=3
