# Auth.js — `openssl rand -base64 32`
AUTH_SECRET=
# GitHub OAuth App (one per environment; callback = <origin>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Repos ENABLED for the review bot, comma-separated (see review/README.md "Enable a repo").
# Each user sees only the ones they can access; sign-in requires access to at least one.
GITHUB_REPOS=tvardev/tvar-business
# Senior dev(s), comma-separated: see and act on every PR, do the final review and merge.
# Everyone else sees only the PRs they opened, and can only request a review from these people.
FINAL_REVIEWER=tvardev
# Claude Code scheduled task "tvar PR review" (created under admin@tvarlaunchpad.com) — API trigger
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=
# Review → fix loop (P5)
REVIEW_SCORE_BAR=80
REVIEW_FIX_ROUNDS=3
